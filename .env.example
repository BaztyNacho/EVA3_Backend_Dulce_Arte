# Copia este archivo como .env y completa tus propios valores.
# El archivo .env nunca debe subirse al repositorio.

# --- Desarrollo (tu computador) ---
DEBUG=True
SECRET_KEY=genera_una_clave_con_secrets_token_urlsafe
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Producción (AWS EC2): usa estos valores en el .env del servidor ---
# DEBUG=False
# SECRET_KEY=una_clave_NUEVA_distinta_a_la_de_desarrollo
# ALLOWED_HOSTS=<DOMINIO>,<IP_PUBLICA>
# CSRF_TRUSTED_ORIGINS=https://<DOMINIO>
# USAR_HTTPS=True

DB_NAME=db_dulce_arte
DB_USER=dulce_user
DB_PASSWORD=tu_contraseña_de_postgresql
DB_HOST=localhost
DB_PORT=5432
